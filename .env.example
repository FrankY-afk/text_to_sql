# ==============================================================================
# Enterprise Text-to-SQL Engine Configuration (Problem 1: MCP + PostgreSQL + HF)
# ==============================================================================

# Runtime Environment: 'development', 'production', or 'test'
TEXT2SQL_ENV=development

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection Settings (Remote Lending Sample / Local PG)
# ------------------------------------------------------------------------------
TEXT2SQL_POSTGRES_HOST=35.200.180.162
TEXT2SQL_POSTGRES_PORT=5432
TEXT2SQL_POSTGRES_USER=t2sql_reader
TEXT2SQL_POSTGRES_PASSWORD=your_password_here
TEXT2SQL_POSTGRES_DB=lending_sample
TEXT2SQL_POSTGRES_SSLMODE=require
TEXT2SQL_POSTGRES_SCHEMA=public

# ------------------------------------------------------------------------------
# Local Benchmark Database (SQLite for Offline Testing & Cohort Ground Truth)
# ------------------------------------------------------------------------------
TEXT2SQL_LOCAL_DB_PATH=./local_problem1.db

# ------------------------------------------------------------------------------
# Hugging Face LLM Configuration (Open-Source Coder Models)
# ------------------------------------------------------------------------------
# Selected LLM Backend: 'huggingface' or 'mock'
TEXT2SQL_LLM_BACKEND=huggingface

# Target Hugging Face Model (e.g. Qwen 2.5 Coder 32B Instruct)
TEXT2SQL_LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Hugging Face API Key / User Access Token (Free tier or Pro)
# You can set HF_API_KEY, HF_TOKEN, or TEXT2SQL_HF_API_TOKEN:
HF_API_KEY=your_huggingface_api_key_here
# TEXT2SQL_HF_API_TOKEN=your_huggingface_api_key_here

# Optional: Dedicated Hugging Face Inference Endpoint URL (if using private endpoint)
TEXT2SQL_HF_ENDPOINT_URL=

# Timeout in seconds for Hugging Face inference requests
TEXT2SQL_HF_TIMEOUT_SECONDS=30

# Sampling temperature (0.0 for deterministic SQL generation)
TEXT2SQL_HF_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# Query Execution Guardrails
# ------------------------------------------------------------------------------
TEXT2SQL_QUERY_TIMEOUT_SECONDS=60
TEXT2SQL_MAX_ROW_LIMIT=100
