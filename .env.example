# ==============================================================================
# Enterprise Text-to-SQL Engine Configuration (Placeholder Values)
# ==============================================================================

# Runtime Environment: 'development', 'production', or 'test'
TEXT2SQL_ENV=development

# Embedding Model Configuration (Local BAAI model)
TEXT2SQL_EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
TEXT2SQL_EMBEDDING_DEVICE=cpu

# Vector Store Path
TEXT2SQL_CHROMA_DB_DIR=./chroma_db

# LLM Backend Selection: 'auto', 'ollama', 'huggingface', 'mock'
# Use 'mock' for offline deterministic unit tests
TEXT2SQL_LLM_BACKEND=auto

# Ollama Local Inference (e.g. Qwen 2.5 Coder 7B / 32B)
TEXT2SQL_OLLAMA_MODEL=qwen2.5-coder:7b
TEXT2SQL_OLLAMA_BASE_URL=http://localhost:11434

# Optional Hugging Face Inference API (DO NOT COMMIT REAL TOKENS)
TEXT2SQL_LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
TEXT2SQL_HF_API_TOKEN=hf_placeholder_token_do_not_commit

# Local Database Path
TEXT2SQL_DUCKDB_PATH=./data/warehouse.duckdb
